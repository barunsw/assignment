<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.barunsw.contact.mapper.GroupMapper">

    <select id="selectGroupList" resultType="ContactGroup">
        SELECT id, name FROM contact_group ORDER BY id
    </select>

    <select id="selectGroupById" resultType="ContactGroup">
        SELECT id, name FROM contact_group WHERE id = #{id}
    </select>

    <!--
        연락처가 0명인 그룹도 나오도록 그룹 쪽을 기준으로 LEFT JOIN한다.
        COUNT(*)는 짝이 없어 c 열이 모두 NULL인 행도 1로 세므로, COUNT(c.id)로 실제 연락처가 있는 행만 센다.
    -->
    <select id="selectGroupSummaryList" resultType="GroupSummary">
        SELECT g.id, g.name, COUNT(c.id) AS contact_count
        FROM contact_group g
        LEFT JOIN contact c ON c.group_id = g.id
        GROUP BY g.id, g.name
        ORDER BY g.id
    </select>

</mapper>
